# ---------------------------------------------------------------------------
# Admin panel (/admin) configuration
# Copy this file to .env.local for local development, and set the same
# variables in your Vercel project settings for production.
# ---------------------------------------------------------------------------

# Password used to log in to the admin panel at /admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# Secret used to sign the admin session cookie.
# Generate one with:  openssl rand -base64 32
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

# ---------------------------------------------------------------------------
# Content storage (Upstash Redis). Added automatically when you connect an
# Upstash integration in the Vercel dashboard. Either UPSTASH_* or KV_* works.
# Leave empty for local development - content falls back to a local JSON file
# in ./.data/content.json (and finally to the built-in default content).
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# Image uploads (Vercel Blob). Added automatically when you connect a Blob
# store in the Vercel dashboard. Leave empty for local development - uploads
# are saved to ./public/uploads instead.
# ---------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=
